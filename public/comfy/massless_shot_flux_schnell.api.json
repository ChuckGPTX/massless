  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Compiled shot prompt" },
    "inputs": { "text": "a lighthouse keeper climbing a spiral staircase, wide shot, low-angle camera, shot on 16mm film, vintage prime lens, 24mm wide-angle lens, aperture f/2.8, moonlit night, faded 1970s film print, cinematic film still", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative (ignored by schnell at cfg 1)" },
    "inputs": { "text": "", "clip": ["4", 1] }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" },
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": { "title": "Hero frame" },
    "inputs": { "filename_prefix": "massless", "images": ["8", 0] }
  }
}
