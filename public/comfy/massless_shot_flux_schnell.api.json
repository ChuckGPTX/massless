{
  "3": {
    "class_type": "KSampler",
    "_meta": { "title": "Sample (FLUX.1 schnell, 4 steps)" },
    "inputs": {
      "seed": 7,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "FLUX.1 schnell fp8 (Apache-2.0)" },
    "inputs": { "ckpt_name": "flux1-schnell-fp8.safetensors" }
  },
  "5": {
    "class_type": "EmptySD3LatentImage",
