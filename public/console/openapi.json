        "summary": "Get one workflow and its studio handoff",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "maxLength": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public discovery response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
