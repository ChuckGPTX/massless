{
  "openapi": "3.1.0",
  "info": {"title":"Chucksi Template Catalog", "version":"2026-11-02", "description":"Read-only catalog of bundled public website examples. No key is required. This API does not generate media, access private projects or publish websites. Publishing remains an authenticated action in the website studio."},
  "servers":[{"url":"https://console.chucksi.com"}],
  "paths": {
    "/api/v1/templates": {"get":{"operationId":"listTemplates","summary":"List editable website templates","parameters":[{"name":"kind","in":"query","required":false,"schema":{"type":"string"},"description":"Filter by an exact kind such as business, portfolio, landing, event or shop."}],"responses":{"200":{"description":"Public catalog","content":{"application/json":{"schema":{"type":"object","required":["version","count","templates"],"properties":{"version":{"type":"string"},"count":{"type":"integer"},"templates":{"type":"array","items":{"$ref":"#/components/schemas/Template"}}}}}}}}}},
    "/api/v1/templates/{id}": {"get":{"operationId":"getTemplate","summary":"Get a public template and its editable site specification","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-z0-9-]+$"},"example":"echo-festival"}],"responses":{"200":{"description":"Template and editable website data","content":{"application/json":{"schema":{"type":"object","required":["version","template","site","mediaBase","usage"],"properties":{"version":{"type":"string"},"template":{"$ref":"#/components/schemas/Template"},"site":{"type":"object","description":"Chucksi website spec version 1: theme, navigation, pages, sections and collections. Renderer and sanitizer: https://github.com/ChuckGPTX/massless/tree/main/public/js/website .","additionalProperties":true},"mediaBase":{"type":"string","format":"uri"},"usage":{"type":"string"}}}}}},"404":{"description":"Unknown template","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}}}
  },
  "components":{"schemas":{"Template":{"type":"object","required":["id","title","kind","description","href","thumb","api","motion"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"kind":{"type":"string"},"description":{"type":"string"},"href":{"type":"string"},"thumb":{"type":"string"},"api":{"type":"string"},"motion":{"type":"string"}},"additionalProperties":true}}}
}
