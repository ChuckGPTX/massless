    "/api/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Check connection capabilities and remote-action availability",
        "responses": {
          "200": {
            "description": "Supported actions and exact access limits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "version",
                    "remoteActions",
                    "authentication",
                    "handoff"
                  ],
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "remoteActions": {
                      "type": "object",
                      "properties": {
                        "generateMedia": {
                          "const": false
                        },
                        "uploadFiles": {
                          "const": false
                        },
                        "readPrivateProjects": {
                          "const": false
                        },
                        "publishWebsites": {
                          "const": false
                        }
                      }
                    },
                    "authentication": {
                      "type": "string"
                    },
                    "handoff": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/templates": {
      "get": {
        "operationId": "listTemplates",
        "summary": "List editable website templates",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by an exact kind such as business, portfolio, landing, event or shop."
          }
        ],
        "responses": {
          "200": {
            "description": "Public catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "version",
                    "count",
                    "templates"
                  ],
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "templates": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Template"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Website compatibility"
        ]
      }
    },
    "/api/v1/templates/{id}": {
      "get": {
        "operationId": "getTemplate",
        "summary": "Get a public template and its editable site specification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "example": "echo-festival"
          }
        ],
        "responses": {
          "200": {
            "description": "Template and editable website data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "version",
                    "template",
                    "site",
                    "mediaBase",
                    "usage"
                  ],
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "template": {
                      "$ref": "#/components/schemas/Template"
                    },
                    "site": {
                      "type": "object",
                      "description": "Chucksi website spec version 1: theme, navigation, pages, sections and collections. Renderer and sanitizer: https://github.com/ChuckGPTX/massless/tree/main/public/js/website .",
                      "additionalProperties": true
                    },
                    "mediaBase": {
                      "type": "string",
                      "format": "uri"
                    },
                    "usage": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown template",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Website compatibility"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Template": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "description",
          "href",
          "thumb",
          "api",
          "motion"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "thumb": {
            "type": "string"
          },
          "api": {
            "type": "string"
          },
          "motion": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "DiscoveryResource": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "execution",
          "remoteExecution"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "studioUrl": {
            "type": "string",
            "format": "uri"
          },
          "category": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "preview": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "format": "uri"
              },
              "video": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "studioUrl"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "studioUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "execution": {
            "const": "studio"
          },
          "remoteExecution": {
            "const": false
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
