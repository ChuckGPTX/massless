{
  "openapi": "3.1.0",
  "info": {
    "title": "Chucksi Agent API",
    "version": "2026-11-02",
    "description": "Connect an AI assistant or application to public Chucksi studio tools, presets and workflow recipes. Public discovery requires no key. Returned studio URLs are handoffs, not remote execution. Generation, uploads, private projects and publishing are not connected."
  },
  "servers": [
    {
      "url": "https://console.chucksi.com"
    }
  ],
  "paths": {
    "/api/v1/tools": {
      "get": {
        "operationId": "listTools",
        "summary": "Discover studio tools",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "description": "Exact category match. Presets: effects or moves."
          }
        ],
        "responses": {
          "200": {
            "description": "Public discovery response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "version",
                    "count",
                    "items"
                  ],
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DiscoveryResource"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Search query too long",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Read-only endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/{id}": {
      "get": {
        "operationId": "getTool",
        "summary": "Get one tool and its studio handoff",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "maxLength": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public discovery response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "version",
                    "item"
                  ],
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "item": {
                      "$ref": "#/components/schemas/DiscoveryResource"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Search query too long",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Read-only endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
