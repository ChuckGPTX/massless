{
  "unet": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Fibo 2.0 edit turbo, bf16 (CC BY-NC 4.0)"
    },
    "inputs": {
      "unet_name": "fibo2_edit_turbo_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Qwen3-VL-4B caption encoder"
    },
    "inputs": {
      "clip_name": "qwen3vl_4b_bf16.safetensors",
      "type": "fibo2",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "FLUX.2 VAE"
    },
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "image_in": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "INPUT image to edit (the node crops it to the trained size for its shape)"
    },
    "inputs": {
      "image": "massless_input.png"
    }
  },
  "text": {
    "class_type": "TextEncodeFibo2",
    "_meta": {
      "title": "INPUT prompt (edit instruction, or a JSON caption with edit_instruction); width/height 0 = trained size for the image"
    },
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "prompt": "a lighthouse at dusk",
      "negative_prompt": "",
      "width": 0,
      "height": 0,
      "batch_size": 1,
      "vae": [
        "vae",
        0
      ],
      "images.image_1": [
        "image_in",
        0
      ]
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "_meta": {
      "title": "INPUT seed, steps (4 steps, CFG 1: the turbo distill)"
    },
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "text",
        0
      ],
      "negative": [
        "text",
        1
      ],
      "latent_image": [
        "text",
        2
      ],
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode"
    },
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "OUTPUT: PNG (the handler re-encodes JPEG q92)"
    },
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "massless/fibo"
    }
  }
}