{
  "unet_high": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Wan 2.2 T2V-A14B high-noise expert, fp8 scaled (Apache-2.0)"
    },
    "inputs": {
      "unet_name": "wan2.2_t2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "unet_low": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Wan 2.2 T2V-A14B low-noise expert, fp8 scaled (Apache-2.0)"
    },
    "inputs": {
      "unet_name": "wan2.2_t2v_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "lora_high": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Quick: Wan2.2-Lightning 4-step LoRA (Apache-2.0). Best mode removes it."
    },
    "inputs": {
      "model": [
        "unet_high",
        0
      ],
      "lora_name": "wan2.2_t2v_lightx2v_4steps_lora_v1.1_high_noise.safetensors",
      "strength_model": 1.0
    }
  },
  "lora_low": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Quick: Wan2.2-Lightning 4-step LoRA (Apache-2.0). Best mode removes it."
    },
    "inputs": {
      "model": [
        "unet_low",
        0
      ],
      "lora_name": "wan2.2_t2v_lightx2v_4steps_lora_v1.1_low_noise.safetensors",
      "strength_model": 1.0
    }
  },
  "shift_high": {
    "class_type": "ModelSamplingSD3",
    "_meta": {
      "title": "Flow shift 5 (ComfyUI's Wan 2.2 14B template)"
    },
    "inputs": {
      "model": [
        "lora_high",
        0
      ],
      "shift": 5.0
    }
  },
  "shift_low": {
    "class_type": "ModelSamplingSD3",
    "_meta": {
      "title": "Flow shift 5"
    },
    "inputs": {
      "model": [
        "lora_low",
        0
      ],
      "shift": 5.0
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "umT5-XXL fp8 (Apache-2.0)"
    },
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Wan 2.1 VAE"
    },
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "prompt": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "INPUT prompt"
    },
    "inputs": {
      "text": "smooth natural motion, cinematic",
      "clip": [
        "clip",
        0
      ]
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "INPUT negative (Wan's stock negative prompt by default)"
    },
    "inputs": {
      "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": [
        "clip",
        0
      ]
    }
  },
  "latent": {
    "class_type": "EmptyHunyuanLatentVideo",
    "_meta": {
      "title": "INPUT size: width, height, length (81 frames = 5 s at 16 fps)"
    },
    "inputs": {
      "width": 832,
      "height": 480,
      "length": 81,
      "batch_size": 1
    }
  },
  "sampler_high": {
    "class_type": "KSamplerAdvanced",
    "_meta": {
      "title": "INPUT high-noise half: seed, steps, cfg, end_at_step (Quick: 4 steps cfg 1; Best: 20 steps cfg 3.5)"
    },
    "inputs": {
      "model": [
        "shift_high",
        0
      ],
      "add_noise": "enable",
      "noise_seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "prompt",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable"
    }
  },
  "sampler_low": {
    "class_type": "KSamplerAdvanced",
    "_meta": {
      "title": "INPUT low-noise half: steps, cfg, start_at_step"
    },
    "inputs": {
      "model": [
        "shift_low",
        0
      ],
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "prompt",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "sampler_high",
        0
      ],
      "start_at_step": 2,
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode frames"
    },
    "inputs": {
      "samples": [
        "sampler_low",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "_meta": {
      "title": "16 fps (Wan 2.2 14B)"
    },
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "fps": 16.0
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "_meta": {
      "title": "OUTPUT: H.264 MP4 (crf set by the handler)"
    },
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "massless/animate",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 19.0
    }
  }
}
