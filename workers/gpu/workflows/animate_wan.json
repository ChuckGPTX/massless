{
  "unet": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Wan 2.2 TI2V-5B fp16 (Apache-2.0)" },
    "inputs": { "unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default" }
  },
  "shift": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "Flow shift 8 (ComfyUI's TI2V-5B template)" },
    "inputs": { "model": ["unet", 0], "shift": 8.0 }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "umT5-XXL fp8 (Apache-2.0)" },
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" }
  },
  "vae": {
    "class_type": "VAELoader",
    "_meta": { "title": "Wan 2.2 VAE" },
    "inputs": { "vae_name": "wan2.2_vae.safetensors" }
  },
  "image_in": {
    "class_type": "LoadImage",
    "_meta": { "title": "INPUT image: first frame (the handler uploads it, already cropped to width x height)" },
    "inputs": { "image": "massless_input.png" }
  },
  "prompt": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "INPUT prompt: what moves" },
    "inputs": { "text": "smooth natural motion, cinematic", "clip": ["clip", 0] }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "INPUT negative (Wan's stock negative prompt by default)" },
    "inputs": {
      "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": ["clip", 0]
    }
  },
  "latent": {
    "class_type": "Wan22ImageToVideoLatent",
    "_meta": { "title": "INPUT size: width, height, length (121 frames = 5 s at 24 fps)" },
    "inputs": { "vae": ["vae", 0], "width": 832, "height": 480, "length": 121, "batch_size": 1, "start_image": ["image_in", 0] }
  },
  "sampler": {
    "class_type": "KSampler",
    "_meta": { "title": "INPUT seed, steps (UniPC, CFG 5, as in ComfyUI's template)" },
    "inputs": {
      "model": ["shift", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["prompt", 0],
      "negative": ["negative", 0],
      "latent_image": ["latent", 0],
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode frames" },
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "video": {
    "class_type": "CreateVideo",
    "_meta": { "title": "24 fps" },
    "inputs": { "images": ["decode", 0], "fps": 24.0 }
  },
  "save": {
    "class_type": "SaveVideo",
    "_meta": { "title": "OUTPUT: H.264 MP4 (crf set by the handler)" },
    "inputs": {
      "video": ["video", 0],
      "filename_prefix": "massless/animate",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 19.0
    }
  }
}
