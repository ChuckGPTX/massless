{
  "unet": {
    "class_type": "UNETLoader",
    "_meta": { "title": "FastWan 2.2 TI2V-5B, 3-step DMD distill (Apache-2.0)" },
    "inputs": { "unet_name": "fastwan2.2_ti2v_5B_bf16.safetensors", "weight_dtype": "default" }
  },
  "shift": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "Flow shift 5 (FastVideo's setting for this model)" },
    "inputs": { "model": ["unet", 0], "shift": 5.0 }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "umT5-XXL fp8 (Apache-2.0)" },
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" }
  },
  "vae": {
    "class_type": "VAELoader",
    "_meta": { "title": "Wan 2.2 VAE" },
    "inputs": { "vae_name": "wan2.2_vae.safetensors" }
  },
  "image_in": {
    "class_type": "LoadImage",
    "_meta": { "title": "INPUT image: first frame (the handler uploads it, already cropped to width x height)" },
    "inputs": { "image": "massless_input.png" }
  },
  "prompt": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "INPUT prompt: what moves" },
    "inputs": { "text": "smooth natural motion, cinematic", "clip": ["clip", 0] }
  },
  "latent": {
    "class_type": "Wan22ImageToVideoLatent",
    "_meta": { "title": "INPUT size: width, height, length (121 frames = 5 s at 24 fps)" },
    "inputs": { "vae": ["vae", 0], "width": 832, "height": 480, "length": 121, "batch_size": 1, "start_image": ["image_in", 0] }
  },
  "guider": {
    "class_type": "BasicGuider",
    "_meta": { "title": "No CFG: the distill was trained at guidance 1" },
    "inputs": { "model": ["shift", 0], "conditioning": ["prompt", 0] }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "_meta": { "title": "LCM step = DMD step (predict clean latent, re-noise to the next sigma)" },
    "inputs": { "sampler_name": "lcm" }
  },
  "sigmas": {
    "class_type": "ManualSigmas",
    "_meta": { "title": "DMD timesteps 1000, 757, 522 (FastWan2_2_TI2V_5B_Config) as sigmas" },
    "inputs": { "sigmas": "1.0, 0.757, 0.522, 0.0" }
  },
  "noise": {
    "class_type": "RandomNoise",
    "_meta": { "title": "INPUT seed" },
    "inputs": { "noise_seed": 0 }
  },
  "sampler": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": { "title": "Sample 3 steps" },
    "inputs": { "noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["sampler_select", 0], "sigmas": ["sigmas", 0], "latent_image": ["latent", 0] }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode frames" },
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "video": {
    "class_type": "CreateVideo",
    "_meta": { "title": "24 fps" },
    "inputs": { "images": ["decode", 0], "fps": 24.0 }
  },
  "save": {
    "class_type": "SaveVideo",
    "_meta": { "title": "OUTPUT: H.264 MP4 (crf set by the handler)" },
    "inputs": {
      "video": ["video", 0],
      "filename_prefix": "massless/animate",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 19.0
    }
  }
}
