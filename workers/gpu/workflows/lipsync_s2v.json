{
  "unet": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Wan 2.2 S2V-14B, fp8 scaled (Apache-2.0)"
    },
    "inputs": {
      "unet_name": "wan2.2_s2v_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "lora": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Quick: Wan2.2-Lightning T2V high-noise LoRA, as in ComfyUI's S2V template. Best mode removes it."
    },
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "wan2.2_t2v_lightx2v_4steps_lora_v1.1_high_noise.safetensors",
      "strength_model": 1.0
    }
  },
  "shift": {
    "class_type": "ModelSamplingSD3",
    "_meta": {
      "title": "Flow shift 8 (ComfyUI's S2V template)"
    },
    "inputs": {
      "model": [
        "lora",
        0
      ],
      "shift": 8.0
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "umT5-XXL fp8 (Apache-2.0)"
    },
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Wan 2.1 VAE"
    },
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "audio_encoder": {
    "class_type": "AudioEncoderLoader",
    "_meta": {
      "title": "wav2vec2 large English (Apache-2.0)"
    },
    "inputs": {
      "audio_encoder_name": "wav2vec2_large_english_fp16.safetensors"
    }
  },
  "audio_in": {
    "class_type": "LoadAudio",
    "_meta": {
      "title": "INPUT speech (WAV, trimmed to <= 10 s by the handler)"
    },
    "inputs": {
      "audio": "massless_speech.wav"
    }
  },
  "listen": {
    "class_type": "AudioEncoderEncode",
    "_meta": {
      "title": "Audio features"
    },
    "inputs": {
      "audio_encoder": [
        "audio_encoder",
        0
      ],
      "audio": [
        "audio_in",
        0
      ]
    }
  },
  "image_in": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "INPUT face: the image to bring to life (uploaded, already cropped to width x height)"
    },
    "inputs": {
      "image": "massless_input.png"
    }
  },
  "prompt": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "INPUT prompt"
    },
    "inputs": {
      "text": "The person is talking to the camera, natural expressions and gestures.",
      "clip": [
        "clip",
        0
      ]
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Wan's stock negative prompt"
    },
    "inputs": {
      "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": [
        "clip",
        0
      ]
    }
  },
  "latent": {
    "class_type": "WanSoundImageToVideo",
    "_meta": {
      "title": "INPUT width, height (77 frames per chunk, as the S2V code)"
    },
    "inputs": {
      "positive": [
        "prompt",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "width": 832,
      "height": 480,
      "length": 77,
      "batch_size": 1,
      "audio_encoder_output": [
        "listen",
        0
      ],
      "ref_image": [
        "image_in",
        0
      ]
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "_meta": {
      "title": "INPUT seed, steps, cfg (Quick: 4 steps cfg 1; Best: 20 steps cfg 6)"
    },
    "inputs": {
      "model": [
        "shift",
        0
      ],
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": [
        "latent",
        0
      ],
      "negative": [
        "latent",
        1
      ],
      "latent_image": [
        "latent",
        2
      ],
      "denoise": 1.0
    }
  },
  "first": {
    "class_type": "LatentCut",
    "_meta": {
      "title": "ComfyUI's template trick: repeat the first latent frame so the VAE does not overbake it"
    },
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "dim": "t",
      "index": 0,
      "amount": 1
    }
  },
  "joined": {
    "class_type": "LatentConcat",
    "_meta": {
      "title": "First frame + every chunk (the handler rewires samples2 to the last extend chunk)"
    },
    "inputs": {
      "samples1": [
        "first",
        0
      ],
      "samples2": [
        "sampler",
        0
      ],
      "dim": "t"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode frames"
    },
    "inputs": {
      "samples": [
        "joined",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "frames": {
    "class_type": "ImageFromBatch",
    "_meta": {
      "title": "INPUT length: drop the 3 repeated frames, keep as many frames as the speech lasts"
    },
    "inputs": {
      "image": [
        "decode",
        0
      ],
      "batch_index": 3,
      "length": 77
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "_meta": {
      "title": "16 fps, with the speech as the soundtrack"
    },
    "inputs": {
      "images": [
        "frames",
        0
      ],
      "fps": 16.0,
      "audio": [
        "audio_in",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "_meta": {
      "title": "OUTPUT: H.264 MP4"
    },
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "massless/lipsync",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 19.0
    }
  }
}
