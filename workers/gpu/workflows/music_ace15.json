{
  "unet": {
    "class_type": "UNETLoader",
    "_meta": { "title": "ACE-Step 1.5 turbo DiT (MIT)" },
    "inputs": { "unet_name": "acestep_v1.5_turbo.safetensors", "weight_dtype": "default" }
  },
  "shift": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "Shift 3 (ComfyUI's ACE-Step 1.5 template)" },
    "inputs": { "model": ["unet", 0], "shift": 3.0 }
  },
  "clip": {
    "class_type": "DualCLIPLoader",
    "_meta": { "title": "Qwen3-0.6B encoder + 1.7B planner LM" },
    "inputs": { "clip_name1": "qwen_0.6b_ace15.safetensors", "clip_name2": "qwen_1.7b_ace15.safetensors", "type": "ace", "device": "default" }
  },
  "vae": {
    "class_type": "VAELoader",
    "_meta": { "title": "ACE-Step 1.5 audio VAE" },
    "inputs": { "vae_name": "ace_1.5_vae.safetensors" }
  },
  "text": {
    "class_type": "TextEncodeAceStepAudio1.5",
    "_meta": { "title": "INPUT tags, lyrics, seed, bpm, duration, key, time signature, language" },
    "inputs": {
      "clip": ["clip", 0],
      "tags": "warm lo-fi hip hop, mellow piano, vinyl crackle",
      "lyrics": "[Instrumental]",
      "seed": 0,
      "bpm": 120,
      "duration": 30.0,
      "timesignature": "4",
      "language": "en",
      "keyscale": "C major",
      "generate_audio_codes": true,
      "cfg_scale": 2.0,
      "temperature": 0.85,
      "top_p": 0.9,
      "top_k": 0,
      "min_p": 0.0
    }
  },
  "negative": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Empty negative (turbo runs at CFG 1)" },
    "inputs": { "conditioning": ["text", 0] }
  },
  "latent": {
    "class_type": "EmptyAceStep1.5LatentAudio",
    "_meta": { "title": "INPUT seconds" },
    "inputs": { "seconds": 30.0, "batch_size": 1 }
  },
  "sampler": {
    "class_type": "KSampler",
    "_meta": { "title": "INPUT seed (8 turbo steps, euler, CFG 1)" },
    "inputs": {
      "model": ["shift", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["text", 0],
      "negative": ["negative", 0],
      "latent_image": ["latent", 0],
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "Decode 48 kHz stereo" },
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "save": {
    "class_type": "SaveAudioAdvanced",
    "_meta": { "title": "OUTPUT: MP3, LAME V0 (about 245 kbit/s VBR)" },
    "inputs": { "audio": ["decode", 0], "filename_prefix": "massless/music", "format": "mp3", "format.quality": "V0" }
  }
}
